; Survival Paradise experimental 6-angle melee art + gameplay mechanics.
config_version=5
[application]
config/name="Survival Paradise Six-Angle Melee QA"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.4","GL Compatibility")
