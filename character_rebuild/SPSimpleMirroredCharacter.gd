extends Node2D
## PC43: minimal, source-art-only two-facing player rig.
## Authoritative RIGHT-facing rig; LEFT is a single visual-root mirror.
## No polygon body placeholders or alterations to legacy player assets.
class_name SPSimpleMirroredCharacter

@export var facing_right: bool = true:
    set(value):
        facing_right = value
        if is_instance_valid(visual_root):
            visual_root.scale.x = 1.0 if value else -1.0

@export var breathing_speed: float = 1.8
@export_range(0.0, 0.02, 0.001) var breathing_amplitude: float = 0.006

var visual_root: Node2D
var skeleton: Skeleton2D
var bones: Dictionary = {}
var sprites: Dictionary = {}
var elapsed: float = 0.0

## Coordinates relative to the center of the hips in the canonical right-facing rest pose.
## Positions here are *placeholder joint locations*, not approved anatomy.
## The art intake will set exact pivots from native approved source measurements.
const BONE_SPECS: Array[Dictionary] = [
    {"name": "pelvis", "parent": "", "pos": Vector2.ZERO},
    {"name": "torso", "parent": "pelvis", "pos": Vector2(0, -22)},
    {"name": "neck", "parent": "torso", "pos": Vector2(0, -31)},
    {"name": "head", "parent": "neck", "pos": Vector2(1, -8)},
    {"name": "shoulder_far", "parent": "torso", "pos": Vector2(-5, -25)},
    {"name": "elbow_far", "parent": "shoulder_far", "pos": Vector2(11, 12)},
    {"name": "wrist_far", "parent": "elbow_far", "pos": Vector2(10, 11)},
    {"name": "shoulder_near", "parent": "torso", "pos": Vector2(5, -25)},
    {"name": "elbow_near", "parent": "shoulder_near", "pos": Vector2(11, 12)},
    {"name": "wrist_near", "parent": "elbow_near", "pos": Vector2(10, 11)},
    {"name": "hip_far", "parent": "pelvis", "pos": Vector2(-5, 4)},
    {"name": "knee_far", "parent": "hip_far", "pos": Vector2(0, 28)},
    {"name": "ankle_far", "parent": "knee_far", "pos": Vector2(1, 28)},
    {"name": "hip_near", "parent": "pelvis", "pos": Vector2(5, 4)},
    {"name": "knee_near", "parent": "hip_near", "pos": Vector2(0, 28)},
    {"name": "ankle_near", "parent": "knee_near", "pos": Vector2(1, 28)}
]

func _ready() -> void:
    visual_root = Node2D.new()
    visual_root.name = "MirroredVisualRoot"
    add_child(visual_root)
    skeleton = Skeleton2D.new()
    skeleton.name = "PlayerSkeleton"
    visual_root.add_child(skeleton)
    for spec in BONE_SPECS:
        var name: String = spec["name"]
        var parent_name: String = spec["parent"]
        var bone := Bone2D.new()
        bone.name = name
        bone.position = spec["pos"]
        # Explicit nondegenerate rest transform for runtime-created bones.
        bone.rest = bone.transform
        bone.autocalculate_length_and_angle = false
        bone.length = 12.0
        if parent_name.is_empty():
            skeleton.add_child(bone)
        else:
            (bones[parent_name] as Bone2D).add_child(bone)
        bones[name] = bone
    skeleton.set_meta("rig_schema", "SP-PC43-single-right-mirrored")
    visual_root.scale.x = 1.0 if facing_right else -1.0
    set_process(true)

## Art is supplied explicitly as transparent textures. Blank joints stay invisible;
## this avoids pretending autogenerated geometry is production art.
func bind_art(part_name: String, texture: Texture2D, offset: Vector2 = Vector2.ZERO, layer: int = 0) -> bool:
    if not bones.has(part_name) or texture == null:
        push_warning("PC43 missing bone or art: " + part_name)
        return false
    if sprites.has(part_name):
        (sprites[part_name] as Sprite2D).queue_free()
    var sprite := Sprite2D.new()
    sprite.name = "Art_" + part_name
    sprite.texture = texture
    sprite.position = offset
    sprite.z_index = layer
    (bones[part_name] as Bone2D).add_child(sprite)
    sprites[part_name] = sprite
    return true

func set_facing_from_horizontal(x_direction: float) -> void:
    if absf(x_direction) > 0.001:
        facing_right = x_direction > 0.0

func _process(delta: float) -> void:
    elapsed += delta
    # Tiny joint-space breathing; no torso rotation or movement of the entire character.
    if bones.has("torso"):
        var breath: float = sin(elapsed * breathing_speed) * breathing_amplitude
        (bones["torso"] as Bone2D).scale = Vector2(1.0, 1.0 + breath)

func reset_pose() -> void:
    elapsed = 0.0
    for bone in bones.values():
        (bone as Bone2D).rotation = 0.0
        (bone as Bone2D).scale = Vector2.ONE
