; Engine configuration for isolated PC42 visual-first rig prototype.
; This does NOT modify the existing Android game.
config_version=5

[application]
config/name="Survival Paradise PC42 Static Reference Rig"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=1580
window/size/viewport_height=660
window/size/window_width_override=1580
window/size/window_height_override=660

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
